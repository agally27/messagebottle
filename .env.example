# Message in a Bottle — environment variables.
# Copy to .env.local for development. Nothing here is required to run the demo;
# without any of it the app runs in demo mode with a local data store.
# NEVER commit real values. Client code only ever sees NEXT_PUBLIC_* variables.

# ── App ────────────────────────────────────────────────────────────────────────
# Public URL used in share links, emails and QR codes (no trailing slash).
# On Vercel it defaults to the production domain if left unset.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Secret used to sign demo sessions and other HMAC tokens. Generate with:
#   openssl rand -hex 32
SESSION_SECRET=
# "true" allows the clearly-labelled demo checkout and demo sign-in. Never set
# this to true on a real production deployment that takes payments.
DEMO_MODE=true
# Demo mode only: entering this secret on the guest sign-in page grants admin access.
DEMO_ADMIN_SECRET=

# ── Data ───────────────────────────────────────────────────────────────────────
# "auto" (default): Supabase when configured, otherwise a local JSON file store.
# "supabase" | "local" | "memory"
DATA_BACKEND=auto
# Local store location (development only).
LOCAL_DATA_DIR=.data

# ── Supabase (auth, Postgres, storage) ─────────────────────────────────────────
# Vercel's Supabase integration sets NEXT_PUBLIC_SUPABASE_ANON_KEY and
# SUPABASE_SERVICE_ROLE_KEY instead; both names are accepted.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Bypasses RLS; used by background jobs and webhooks.
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=gift-assets

# ── AI providers (all optional; local/demo providers are used when absent) ─────
# Story: "auto" (Anthropic when key present, else local) | "anthropic" | "local"
STORY_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Images: "procedural" (default, generated SVG scenes) | "openai"
IMAGE_PROVIDER=procedural
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1
# Music: "procedural" (default, generated in the browser) — no external provider yet.
MUSIC_PROVIDER=procedural
# Narration: "none" (default; recipient can use their device voice) | "elevenlabs"
NARRATION_PROVIDER=none
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# ── Generation controls ────────────────────────────────────────────────────────
# Maximum generations a sender may start per hour.
GENERATION_RATE_LIMIT_PER_HOUR=5
# Secret for the background job runner endpoint (/api/jobs/run). Generate with openssl.
JOBS_SECRET=
# Abandoned drafts and failed gifts are deleted after this many days (POST /api/jobs/run?sweep=1).
DRAFT_RETENTION_DAYS=90

# ── Payments (Stripe) ──────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
EMAIL_FROM="Message in a Bottle <hello@example.com>"

# ── Products ───────────────────────────────────────────────────────────────────
# Physical keepsakes (bottles, gift box) are hidden and refused unless "on".
# Leave off until a supplier and packing process exist.
PHYSICAL_PRODUCTS=off

# ── Admin ──────────────────────────────────────────────────────────────────────
# Comma-separated list of admin email addresses (Supabase auth) for /admin.
ADMIN_EMAILS=
